import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allBlogs = await getCollection('blog');


const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://jichangmao.com/#website",
      "url": "https://jichangmao.com/",
      "name": "机场猫",
      "description": "2026机场推荐、稳定机场筛选、专线机场对比、价格与节点测评的专业网站。整理高性价比便宜机场与高速机场排行榜。"
    },
    {
      "@type": "Organization",
      "@id": "https://jichangmao.com/#organization",
      "name": "机场猫",
      "url": "https://jichangmao.com/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://jichangmao.com/logo.jpg"
      }
    }
  ]
});

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Filter out reviews to only show guide articles
const guidePosts = posts.filter(post => {
  return post.data.category !== '品牌介绍' && post.data.category !== '机场测评' && !post.data.title.includes('测评');
});
const latestPosts = guidePosts.slice(0, 3);

// Fetch evaluations for the new section
const allEvals: any[] = []; // disabled evaluations query to fix build
const latestEvals = allEvals.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
  const getPostUrl = (post: any) => {
    const isReview = post.data.category === '品牌介绍' || post.data.category === '机场测评' || post.data.title.includes('测评');
    return isReview ? `/evaluations/${post.slug}/` : `/blog/${post.slug}/`;
  };

---

<BaseLayout title="2026机场推荐：稳定、靠谱、好用机场精选门户 - 机场猫" description="机场猫是一个为您提供2026机场推荐、稳定机场筛选、靠谱机场与好用机场测评的专业网站。助您快速找到适合自己的优质网络代理服务。" keywords="机场推荐,2026机场推荐,机场推荐2026,稳定机场推荐,靠谱机场推荐,好用机场推荐" jsonLd={jsonLd}>
  
  <main class="w-full relative z-10 flex flex-col bg-slate-50 dark:bg-slate-950/50 min-h-screen">
    
    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 lg:pt-32 lg:pb-16 overflow-hidden">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 md:px-8 text-center relative z-10">
        <div class="reveal-el flex flex-col md:flex-row items-center justify-center gap-4 md:gap-6 mb-6">
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15] drop-shadow-sm">
            2026 机场推荐：稳定、靠谱、好用机场指南</h1>
          <img src="/logo-compressed.jpg" alt="机场猫 Logo" class="w-20 h-20 md:w-24 md:h-24 rounded-2xl object-cover shadow-xl border-4 border-white dark:border-slate-800 rotate-3 hover:rotate-0 transition-transform duration-300 flex-shrink-0" />
        </div>
        <p class="reveal-el reveal-delay-100 text-lg sm:text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto mb-6 leading-relaxed">
          机场猫专注于 2026 机场推荐、稳定机场筛选、便宜机场对比与专线机场测评。无论你需要 Clash机场推荐、Shadowrocket机场推荐还是按量计费机场，这里都有详细的选购指南。        </p>
        <div class="reveal-el reveal-delay-200 flex flex-wrap items-center justify-center gap-4 mt-8">
          <a href="/reviews/" class="px-8 py-3.5 rounded-xl bg-primary-600 text-white font-bold text-lg hover:bg-primary-700 transition-colors shadow-sm">机场推荐</a>
          <a href="/guides/" class="px-8 py-3.5 rounded-xl bg-white dark:bg-slate-800 text-slate-900 dark:text-white border border-slate-200 dark:border-slate-700 font-bold text-lg hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors shadow-sm">新手教程</a>
        </div>
      </div>
    </section>

    
    <!-- 重点入口与温馨提示 (两栏布局) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 w-full relative z-10 mb-16 mt-8">
      <div class="flex flex-col lg:flex-row gap-8 items-start">
        
            <!-- 左侧：重点入口 (30秒选方向) -->
        <div class="w-full lg:flex-1">
            <div class="mb-4 flex items-start gap-3">
                <div class="w-10 h-10 bg-slate-100 dark:bg-slate-800 rounded-xl flex items-center justify-center text-xl shadow-sm border border-slate-200 dark:border-slate-700 flex-shrink-0">
                    🧭
                </div>
                <div>
                    <h2 class="text-xl font-black text-slate-900 dark:text-white mb-1">30 秒先选方向</h2>
                    <p class="text-sm text-slate-500 dark:text-slate-400">别在八个分类里盲猜；先确定您现在主要想解决什么问题。</p>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                
                <!-- Card 1 -->
                <a href="/reviews/" class="block bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 hover:shadow-md hover:border-primary-300 dark:hover:border-primary-700 transition-all group">
                    <div class="flex items-start gap-3">
                        <div class="text-2xl grayscale group-hover:grayscale-0 transition-all opacity-80 group-hover:opacity-100 mt-1">✈️</div>
                        <div>
                            <h3 class="text-base font-extrabold text-slate-900 dark:text-white mb-1">科学上网订阅</h3>
                            <div class="text-primary-600 dark:text-primary-400 font-bold text-xs mb-1 group-hover:underline">去机场推荐&rarr;</div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">先试用或月付，对照各品牌测速与风险状态再做决定。</p>
                        </div>
                    </div>
                </a>

                <!-- Card 2 -->
                <a href="/guides/" class="block bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 hover:shadow-md hover:border-blue-300 dark:hover:border-blue-700 transition-all group">
                    <div class="flex items-start gap-3">
                        <div class="text-2xl grayscale group-hover:grayscale-0 transition-all opacity-80 group-hover:opacity-100 mt-1">📚</div>
                        <div>
                  <h3 class="text-base font-extrabold text-slate-900 dark:text-white mb-1">还不懂怎么买？</h3>
                            <div class="text-blue-600 dark:text-blue-400 font-bold text-xs mb-1 group-hover:underline">从新手教程学起 &rarr;</div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">3天上手课表：基础概念 &rarr; 防坑指南 &rarr; 客户端傻瓜式配置。</p>
                        </div>
                    </div>
                </a>

                <!-- Card 3 -->
                <a href="/guides/" class="block bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 hover:shadow-md hover:border-emerald-300 dark:hover:border-emerald-700 transition-all group">
                    <div class="flex items-start gap-3">
                        <div class="text-2xl grayscale group-hover:grayscale-0 transition-all opacity-80 group-hover:opacity-100 mt-1">🧠</div>
                        <div>
                            <h3 class="text-base font-extrabold text-slate-900 dark:text-white mb-1">专线网络科普</h3>
                            <div class="text-emerald-600 dark:text-emerald-400 font-bold text-xs mb-1 group-hover:underline">查阅知识库 &rarr;</div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">深入了解 IPLC / IEPL 原理与流媒体原生解锁的底层逻辑。</p>
                        </div>
                    </div>
                </a>

                <!-- Card 4 -->
                <a href="/tools/" class="block bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 hover:shadow-md hover:border-amber-300 dark:hover:border-amber-700 transition-all group">
                    <div class="flex items-start gap-3">
                        <div class="text-2xl grayscale group-hover:grayscale-0 transition-all opacity-80 group-hover:opacity-100 mt-1">🛠️</div>
                        <div>
                            <h3 class="text-base font-extrabold text-slate-900 dark:text-white mb-1">日常检测辅助</h3>
                            <div class="text-amber-600 dark:text-amber-400 font-bold text-xs mb-1 group-hover:underline">使用网络工具 &rarr;</div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">日常常用功能，包括 IP 纯净度检测、WebRTC 泄漏与 DNS 污染排查。</p>
