            <div class="p-6 flex flex-col flex-grow">
              <div class="flex items-center gap-3 mb-4">
                <span class="text-xs font-bold text-primary-700 bg-primary-50 dark:bg-primary-900/30 dark:text-primary-400 px-2.5 py-1 rounded-md">{post.data.category || '推荐'}</span>
                <span class="text-xs text-slate-500 font-medium">{new Date(post.data.pubDate).toLocaleDateString('zh-CN')}</span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 group-hover:text-primary-600 transition-colors line-clamp-2 leading-snug">{post.data.title}</h3>
              <p class="text-slate-600 dark:text-slate-400 text-sm line-clamp-3 mb-6 flex-grow leading-relaxed">{post.data.description}</p>
              <div class="mt-auto flex items-center text-primary-600 dark:text-primary-400 text-sm font-bold">
                阅读全文 <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 新手从这里开始 -->
    <section class="max-w-7xl mx-auto px-4 w-full mb-24 overflow-visible">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-3">新手从这里开始</h2>
        <p class="text-lg text-slate-600 dark:text-slate-400 mt-1">第一次接触此类工具？不用怕，跟着这里的 4 步走，轻松搞定网络配置。</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6 relative">
        
        <!-- 步骤 1 -->
        <div class="relative group">
          <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 lg:p-8 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-xl hover:border-blue-500 transition-all flex flex-col h-full z-10 relative">
            <div class="w-12 h-12 bg-blue-100 text-blue-600 dark:bg-blue-900/40 dark:text-blue-400 rounded-2xl flex items-center justify-center font-black text-xl mb-6">1</div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-5 group-hover:text-blue-600 transition-colors">了解基础</h3>
            <ul class="space-y-3.5 flex-grow text-slate-600 dark:text-slate-400 text-sm font-medium">
              <li><a href="/blog/what-is-airport-proxy/" class="hover:text-blue-600 dark:hover:text-blue-400 block transition-colors">&bull; 什么是机场？</a></li>
                <li><a href="/blog/what-is-node/" class="hover:text-blue-600 dark:hover:text-blue-400 block transition-colors">&bull; 什么是节点？</a></li>
                <li><a href="/blog/what-is-subscription/" class="hover:text-blue-600 dark:hover:text-blue-400 block transition-colors">&bull; 什么是订阅链接？</a></li>
            </ul>
          </div>
          <div class="hidden lg:flex absolute top-1/2 -right-4 -translate-y-1/2 z-20 w-8 h-8 items-center justify-center text-slate-300 dark:text-slate-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </div>
          <div class="flex lg:hidden absolute -bottom-6 left-1/2 -translate-x-1/2 z-20 w-8 h-8 items-center justify-center text-slate-300 dark:text-slate-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
          </div>
        </div>

        <!-- 步骤 2 -->
        <div class="relative group">
          <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 lg:p-8 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-xl hover:border-emerald-500 transition-all flex flex-col h-full z-10 relative">
            <div class="w-12 h-12 bg-emerald-100 text-emerald-600 dark:bg-emerald-900/40 dark:text-emerald-400 rounded-2xl flex items-center justify-center font-black text-xl mb-6">2</div>
