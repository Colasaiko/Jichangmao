<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.brand-card');
    const tableRows = document.querySelectorAll('.brand-table-row');

    // Function to apply a specific filter programmatically
    const applyFilter = (filterValue) => {
        const targetBtn = Array.from(filterBtns).find(btn => btn.getAttribute('data-filter') === filterValue);
        if (targetBtn) {
            targetBtn.click();
        }
    };

    // Check if there is a filter in the URL hash (e.g., #filter=daily)
    if (window.location.hash.startsWith('#filter=')) {
        const initialFilter = window.location.hash.replace('#filter=', '');
        // Small delay to ensure rendering is complete
        setTimeout(() => applyFilter(initialFilter), 100);
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Reset styles for all filter buttons
        filterBtns.forEach(b => {
          b.classList.remove('bg-blue-600', 'text-white', 'border-blue-600', 'shadow-md');
          b.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-700');
        });
        
        // Set active style for clicked button
        btn.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-700');
        btn.classList.add('bg-blue-600', 'text-white', 'border-blue-600', 'shadow-md');

        const filter = btn.getAttribute('data-filter');
        
        // Filter the cards using .includes() to support multiple tags
        cards.forEach(card => {
          const categories = card.getAttribute('data-category') || '';
          if (filter === 'all' || categories.includes(filter)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
        
        // Filter the table rows using .includes()
        tableRows.forEach(row => {
          const categories = row.getAttribute('data-category') || '';
          if (filter === 'all' || categories.includes(filter)) {
            row.style.display = ''; // Reset to default
          } else {
            row.style.display = 'none';
          }
        });

        // Smooth scroll back up if the user has scrolled past the list
        const listSection = document.getElementById('all-brands');
        if (listSection) {
            // If the top of the list is higher than 100px from the viewport top, we scroll back to it.
            // 100px is roughly the height of the sticky header.
            if (listSection.getBoundingClientRect().top < 100) {
                listSection.scrollIntoView({ behavior: 'smooth' });
            }
        }
        

      });
    });
  });
</script>