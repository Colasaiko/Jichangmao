---
import BottomMenuNav from '../components/BottomMenuNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allClientPosts = await getCollection('clients');


const clientApps: Record<string, {name: string, desc: string, url: string, tags: string[]}[]> = {
  windows: [
    { name: 'v2rayN', desc: 'Windows 上最受欢迎的经典 V2Ray 客户端，支持 Vmess、Vless、Trojan 等几乎所有主流协议，界面直观，适合所有用户。', url: 'https://github.com/2dust/v2rayN/releases', tags: ['免费开源', '小白推荐', '全协议支持'] },
    { name: 'Clash Verge Rev', desc: '基于 Tauri 的全新 Clash 跨平台客户端，支持强大的 Meta 核心（包含 Hysteria2 等最新协议），界面极为现代化。', url: 'https://github.com/clash-verge-rev/clash-verge-rev/releases', tags: ['免费开源', '进阶首选', 'UI极佳'] },
    { name: 'NekoRay', desc: '基于 Qt 开发的跨平台代理客户端，原生支持 Sing-box 和 Xray 双核心，性能强劲，路由规则配置灵活。', url: 'https://github.com/MatsuriDayo/nekoray/releases', tags: ['免费开源', '双核心', '高性能'] },
    { name: 'Clash for Windows', desc: '曾经最流行的老牌 Clash 客户端，虽然原作者已停更，但其汉化版依然是许多老用户的装机必备。', url: '#', tags: ['已停更', '经典老牌'] }
  ],
  android: [
    { name: 'v2rayNG', desc: '安卓平台最稳定、最经典的代理客户端，更新频繁，支持最新的 Xray 核心特性，耗电量控制优秀。', url: 'https://github.com/2dust/v2rayNG/releases', tags: ['免费开源', '装机必备', '超强稳定'] },
    { name: 'Clash Meta for Android', desc: '手机端的 Clash 神器，直接集成强大的 Meta 内核，支持覆写规则、分应用代理，极大提升手机上网体验。', url: 'https://github.com/MetaCubeX/ClashMetaForAndroid/releases', tags: ['免费开源', '高级分流', '全能型'] },
    { name: 'Surfboard', desc: '全面兼容 Surge 配置文件格式的安卓客户端，UI 设计在安卓代理软件中堪称一绝，操作逻辑顺滑。', url: 'https://github.com/getsurfboard/surfboard/releases', tags: ['免费', 'Surge兼容', '高颜值'] },
    { name: 'NekoBox', desc: '安卓端的技术极客最爱！深度整合 Sing-box 核心，不仅协议支持全面，还内置了极强的自定义路由功能。', url: 'https://github.com/MatsuriDayo/NekoBoxForAndroid/releases', tags: ['免费开源', '极客专属', 'Sing-box'] },
    { name: 'SagerNet', desc: '一个通用的 Android 代理客户端，旨在为用户提供类似 iOS 端的无缝代理体验。', url: 'https://github.com/SagerNet/SagerNet', tags: ['已归档', '通用框架'] }
  ],
  macos: [
    { name: 'Clash Verge Rev', desc: '完美支持 Apple Silicon (M1/M2/M3) 芯片，不仅提供漂亮的图形界面，更具备原生的运行性能。', url: 'https://github.com/clash-verge-rev/clash-verge-rev/releases', tags: ['免费开源', '原生支持', '极速'] },
    { name: 'V2rayU', desc: '拥有极为轻量级的 Mac 顶部菜单栏交互，一键切换节点和代理模式，是追求极简体验的绝佳选择。', url: 'https://github.com/yanue/V2rayU/releases', tags: ['免费开源', '菜单栏', '极简'] },
    { name: 'Surge Mac', desc: 'Mac 平台上最强大的网络开发和代理工具，价格昂贵但功能无可匹敌，适合网络工程师和专业玩家。', url: 'https://nssurge.com/', tags: ['昂贵', '专业级', '抓包'] },
    { name: 'ClashX Pro', desc: '曾经 Mac 上最流行的 Clash 客户端增强版，提供增强模式（TUN），目前已停止维护。', url: '#', tags: ['已停更', 'TUN模式'] }
  ],
  ios: [
    { name: 'Shadowrocket (小火箭)', desc: '国人最熟知的 iOS 代理神仙软件，性价比极高，协议更新速度永远领先全网，小白闭眼入。', url: 'https://apps.apple.com/us/app/shadowrocket/id932747118', tags: ['付费买断', '$2.99', '性价比之王'] },
    { name: 'Quantumult X (圈X)', desc: '不仅能科学上网，更具备强大的重写（Rewrite）、去广告和脚本执行功能，iOS 进阶用户的最终归宿。', url: 'https://apps.apple.com/us/app/quantumult-x/id1443988620', tags: ['付费买断', '$7.99', '全能神器'] },
    { name: 'Loon', desc: 'UI 设计极为现代的 iOS 代理工具，配置简单直观，插件生态丰富，是介于小火箭与圈X之间的完美折中。', url: 'https://apps.apple.com/us/app/loon/id1373567447', tags: ['付费买断', '$5.99', '高颜值'] },
    { name: 'Stash', desc: 'iOS 端的 Clash 完美复刻版！完全兼容电脑端 Clash 的 YAML 规则，实现多端配置无缝同步。', url: 'https://apps.apple.com/us/app/stash/id1596063349', tags: ['付费买断', '$3.99', 'Clash生态'] },
    { name: 'Surge iOS', desc: 'iOS 端代理软件的开山鼻祖，价格极其昂贵（百美元级），但提供最底层的网络控制体验。', url: 'https://apps.apple.com/us/app/surge-5/id1442620678', tags: ['极度昂贵', '标杆级'] }
  ],
  linux: [
    { name: 'Clash Verge Rev', desc: '少有的为 Linux 桌面环境（Ubuntu/Debian 等）提供完整且美观 GUI 界面的代理客户端。', url: 'https://github.com/clash-verge-rev/clash-verge-rev/releases', tags: ['免费开源', '图形界面'] },
    { name: 'v2raya', desc: '极其轻量的 Linux 代理工具，提供 Web GUI 界面，可以在无桌面的服务器环境中轻松通过浏览器管理配置。', url: 'https://github.com/v2rayA/v2rayA/releases', tags: ['免费开源', 'Web-GUI', '服务端'] },
    { name: 'mihomo (Clash Meta)', desc: '强大的纯命令行内核，适合部署在 Linux 旁路由或服务器上，通过编写 YAML 文件实现全自动代理。', url: 'https://github.com/MetaCubeX/mihomo/releases', tags: ['无GUI', '核心程序'] }
  ],
  harmony: [
    { name: '鸿蒙与安卓的兼容性说明', desc: '【新手必看】HarmonyOS 3.0 和 4.0 依然保留了安卓兼容层，所以您可以直接下载下方的安卓应用（如 v2rayNG）。但未来的 HarmonyOS NEXT（纯血鸿蒙）将彻底不再支持安卓 APP。', url: '#', tags: ['科普提示', '必读'] },
    { name: 'v2rayNG (鸿蒙 3.0/4.0 适用)', desc: '如果您当前使用的是非 NEXT 版本的鸿蒙系统，直接下载这款经典的安卓 V2Ray 客户端即可完美运行，完全不影响科学上网。', url: 'https://github.com/2dust/v2rayNG/releases', tags: ['免费开源', '完美兼容'] },
    { name: 'Clash Meta for Android (鸿蒙 3.0/4.0 适用)', desc: '在当前大部分华为手机上均可直接安装运行，耗电、分流和网络接管功能与原生安卓机型体验完全一致。', url: 'https://github.com/MetaCubeX/ClashMetaForAndroid/releases', tags: ['免费开源', '直接运行'] },
    { name: 'V2Ray NEXT (开发中)', desc: '【纯血鸿蒙专属】针对即将剥离安卓的 HarmonyOS NEXT 星河版，社区开发者正在使用 ArkUI 原生开发的专属代理客户端。', url: 'https://github.com/', tags: ['纯血鸿蒙', '原生开发', '敬请期待'] },
    { name: 'Clash NEXT (规划中)', desc: '【纯血鸿蒙专属】基于 Clash 核心的纯血鸿蒙原生版本，目前仍在底层核心（Rust/C++）到 ArkTS 的交叉编译适配阶段。', url: 'https://github.com/', tags: ['纯血鸿蒙', '底层适配', '敬请期待'] }
  ],
  router: [
    { name: 'OpenClash', desc: 'OpenWrt 路由器上最强大、最硬核的 Clash 插件，通过极其复杂的图形界面提供全屋无死角科学上网。', url: 'https://github.com/vernesong/OpenClash/releases', tags: ['免费开源', 'OpenWrt', '全屋代理'] },
    { name: 'PassWall', desc: '老牌且极度稳定的路由器代理插件，相比 OpenClash 配置更直观，协议支持非常全面。', url: 'https://github.com/xiaorouji/openwrt-passwall/releases', tags: ['免费开源', '超高稳定', '易配置'] },
    { name: 'ShellCrash', desc: '不需要任何图形界面的核心脚本，可以直接通过 SSH 在各种主流路由器系统上极其轻量地运行代理。', url: 'https://github.com/juewuy/ShellCrash', tags: ['免费开源', '极轻量', 'SSH操作'] },
    { name: 'ShadowSocksR Plus+', desc: '早年间最经典的路由器插件，虽然界面较老，但因其极低的资源占用率，依然活跃在大量低配路由器中。', url: 'https://github.com/fw876/helloworld', tags: ['低配福音', '经典插件'] }
  ],
  tools: [
    { name: 'Subconverter (万能订阅转换)', desc: '将普通 V2Ray/SSR 订阅链接，一键转换为 Clash/Surge/Loon 等专用格式的万能工具。', url: 'https://sub-web.netlify.app/', tags: ['在线工具', '极简操作', '格式转换'] },
    { name: 'v2rayse (在线订阅节点抓取)', desc: '强大的在线节点解析与分享平台，帮助你测试节点的连通性、延迟以及真伪。', url: 'https://v2rayse.com/', tags: ['免费查询', '节点测试'] },
    { name: 'Ping0.cc (IP 伪装度测试)', desc: '专业测试你的代理节点 IP 是否足够纯净，是否会被 Netflix/Disney+ 等流媒体网站无情拦截。', url: 'https://ping0.cc/', tags: ['IP测试', '防流媒体封锁'] },
    { name: 'Speedtest.net', desc: '全球最权威的测速工具，科学上网后用来测试机场晚高峰真实带宽和延迟的最佳平台。', url: 'https://www.speedtest.net/', tags: ['测速', '全球节点'] }
  ],
  changelog: [],
  guide: []
};


const changelogs = [
  {
    date: '2026-08-27',
