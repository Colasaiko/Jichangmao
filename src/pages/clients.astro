    items: [
      { type: '✨ 优化', typeColor: 'text-blue-600 bg-blue-50 dark:bg-blue-900/30', title: '全球流媒体分流升级', desc: '重构了针对 Netflix、Disney+ 等主流海外流媒体的路由分流策略，降低了 DNS 泄露风险。', tags: ['流媒体', '规则'] },
      { type: '⚠️ 下架', typeColor: 'text-rose-600 bg-rose-50 dark:bg-rose-900/30', title: '移除失效的去广告库', desc: '剔除了一些已经超过半年未更新的国内视频网站去广告规则，提升了客户端启动加载速度。', tags: ['规则瘦身'] }
    ]
