    items: [
      { type: '🚀 新增', typeColor: 'text-emerald-600 bg-emerald-50 dark:bg-emerald-900/30', title: '四大平台教程首发', desc: '首批上线了针对 Windows、macOS、iOS 和 Android 四大主流平台的极速配置教程。', tags: ['全平台', '教程'] },
      { type: '✨ 优化', typeColor: 'text-blue-600 bg-blue-50 dark:bg-blue-900/30', title: '桌面端配图放大', desc: '针对 Mac 和 Windows 教程，专项优化了横屏截图的最大显示宽度，字迹更加清晰。', tags: ['排版优化'] }
    ]
