    items: [
      { type: '🚀 新增', typeColor: 'text-emerald-600 bg-emerald-50 dark:bg-emerald-900/30', title: 'Meta 内核推广', desc: '全面将电脑端推荐软件从老旧的 Clash 替换为支持 Hysteria2 协议的 Clash Verge Rev。', tags: ['内核升级', 'Hysteria2'] },
