    items: [
      { type: '🚀 新增', typeColor: 'text-emerald-600 bg-emerald-50 dark:bg-emerald-900/30', title: '补充 HarmonyOS 专区', desc: '新增了针对华为鸿蒙系统（包含 3.0/4.0 兼容层及 NEXT 星河版）的专业解答与工具预告。', tags: ['HarmonyOS', '首发'] },
      { type: '✨ 优化', typeColor: 'text-blue-600 bg-blue-50 dark:bg-blue-900/30', title: '智能下载按钮', desc: '下载按钮现已支持自动检测链接属性，智能切换「官方 GitHub」与「App Store」标识。', tags: ['UI/UX', '动态展示'] },
      { type: '🔧 修复', typeColor: 'text-amber-600 bg-amber-50 dark:bg-amber-900/30', title: '路由器板块链接修正', desc: '修复了 ShadowSocksR Plus+ 在点击时无法正确跳转至开源仓库的漏洞。', tags: ['路由器', '链接修复'] }
