const sections = [
  { id: 'windows', icon: '💻', name: 'Windows' },
  { id: 'android', icon: '📱', name: 'Android' },
  { id: 'ios', icon: '🍎', name: 'iOS' },
  { id: 'macos', icon: '🍏', name: 'macOS' },
  { id: 'linux', icon: '🐧', name: 'Linux' },
  { id: 'harmony', icon: '🌸', name: 'HarmonyOS' },
