                ))}

              </div>
            ) : (
              <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm min-h-[150px] flex items-center justify-center text-slate-400">
                {sec.name} 资源及教程整理中...
              </div>
            )}
          </section>
        );
      })}


      {/* 底部探索更多资源 */}
          </div>
<BottomMenuNav />
  </main>



<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('toggle-changelogs');
    const textSpan = document.getElementById('toggle-changelogs-text');
    const iconSvg = document.getElementById('toggle-changelogs-icon') as HTMLElement | null; //('toggle-changelogs-icon');
    
    let isExpanded = false;
    
    if (btn) {
      btn.addEventListener('click', () => {
        isExpanded = !isExpanded;
        const collapsibleItems = document.querySelectorAll('.changelog-collapsible');
        
        if (isExpanded) {
          // Expand
          if(textSpan) textSpan.textContent = '收起历史记录';
          iconSvg?.classList.remove('mt-1');
          iconSvg?.classList.add('rotate-180', 'mb-1');
          
          collapsibleItems.forEach((el, index) => {
            el.classList.remove('hidden');
            // Staggered fade in animation
            setTimeout(() => {
              el.classList.remove('opacity-0', 'translate-y-4');
            }, 50 * index);
          });
        } else {
          // Collapse
          if(textSpan) textSpan.textContent = '查看更早的历史记录';
          iconSvg?.classList.remove('rotate-180', 'mb-1');
          iconSvg?.classList.add('mt-1');
          
          // Instantly add styles back
          collapsibleItems.forEach((el) => {
            el.classList.add('opacity-0', 'translate-y-4');
            // wait for transition to finish before hiding
            setTimeout(() => {
              el.classList.add('hidden');
            }, 300);
          });
          
          // Optionally scroll back up slightly so the user doesn't get lost
          const changelogSection = document.getElementById('changelog');
          if (changelogSection) {
            changelogSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    }
  });
</script>
</BaseLayout>
