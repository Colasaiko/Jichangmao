    </main>
    <MarkdownDecorator />
    <FloatingAction />
    <Footer />
    
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const pathParts = window.location.pathname.split('/').filter(Boolean);
        if (pathParts[0] === 'blog' && pathParts[1]) {
          localStorage.setItem('lastReadArticle', pathParts[1]);
        }
      });
      
      const updateProgress = () => {
        const article = document.querySelector('.article-content-wrapper') || document.querySelector('article');
        const progressBar = document.getElementById('reading-progress-bar');
        const progressText = document.getElementById('reading-progress-text');
        
        if (!article || !progressBar || !progressText) return;
        
        const rect = article.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        
        // Offset for sticky header and some padding
        const headerOffset = 150; 
        const totalScrollable = rect.height - windowHeight + headerOffset;
        
        let progress = 0;
        const scrolledAmount = headerOffset - rect.top;
        
        if (scrolledAmount > 0) {
          if (totalScrollable > 0) {
            progress = (scrolledAmount / totalScrollable) * 100;
          } else {
            progress = 100;
          }
        }
        
        progress = Math.max(0, Math.min(100, Math.round(progress)));
        
        progressBar.style.width = progress + '%';
        progressText.textContent = progress + '%';
      };
      
      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress, { passive: true });
      setTimeout(updateProgress, 100);
      
      // Fallback for Astro View Transitions if enabled
      document.addEventListener('astro:page-load', () => {
        setTimeout(updateProgress, 100);
      });
    </script>

  </body>
