---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MarkdownDecorator from '../components/MarkdownDecorator.astro';
import FloatingAction from '../components/FloatingAction.astro';
// @ts-ignore
import FormattedDate from '../components/FormattedDate.astro';
import fs from 'node:fs';
import path from 'node:path';
import brandsData from '../data/brands.json';
import brandReviewsData from '../data/brand_reviews.json';
import brandDates from '../data/brand_dates.json';
import brandDetailsData from '../data/brand_details.json';
import brandTechData from '../data/brand_technical_details.json';
import brandPricingData from '../data/brand_pricing.json';

type Props = CollectionEntry<'blog'>['data'] & { headings?: any[], readTime?: string, heroImage?: string, jsonLd?: string };


const { title, description, pubDate, updatedDate, heroImage, category, article_type, keywords, jsonLd } = Astro.props;

// Determine colors based on article_type
const typeColors = {
  'Tutorial': 'text-blue-600 bg-blue-50 border-blue-200 dark:bg-blue-900/30 dark:border-blue-800/50',
  'Concept': 'text-purple-600 bg-purple-50 border-purple-200 dark:bg-purple-900/30 dark:border-purple-800/50',
  'Troubleshoot': 'text-red-600 bg-red-50 border-red-200 dark:bg-red-900/30 dark:border-red-800/50',
  'Guide': 'text-emerald-600 bg-emerald-50 border-emerald-200 dark:bg-emerald-900/30 dark:border-emerald-800/50',
  'Hub': 'text-indigo-600 bg-indigo-50 border-indigo-200 dark:bg-indigo-900/30 dark:border-indigo-800/50',
};
const typeKey = Object.keys(typeColors).find(k => article_type && article_type.includes(k)) || 'Tutorial';
const badgeColorClass = typeColors[typeKey as keyof typeof typeColors];

const isReview = category === '品牌介绍';
const slug = Astro.url.pathname.split('/').filter(Boolean).pop() || '';
const brandId = slug.replace('review-', '');
const pricingData = (brandPricingData as Record<string, any>)[brandId] || [];
const brand = brandsData.find(b => b.id === brandId) || {} as any;
const reviewData = (brandReviewsData as Record<string, any>)[brandId] || {
  conclusion_title: "高端主力候选，短周期谨慎推荐",
  conclusion_text: "该品牌主打稳定的节点线路，套餐价格适中，拥有较好的晚高峰网络体验。",
  fit: ["流媒体重度用户", "需要多地区节点切换的人"],
  unfit: ["极致低价党", "首次购买主力套餐的人"],
  check: ["本地运营商宽带是否能跑满上限", "晚高峰测速待进一步观察"]
};
const detailData = (brandDetailsData as Record<string, any>)[brandId] || {
  rating: {
    transparency: "公开透明", priceThreshold: "门槛适中", nodeProtocol: "专线 / SS",
    latency: "常规", ipQuality: "较好", risks: "暂无"
  },
  packages: {
    entry: "全开放注册", lifetime: "主打周期订阅", daily: "无",
    devices: "限制终端", advice: "建议月付试用"
  }
};
const techData = (brandTechData as Record<string, any>)[brandId] || {
  nodes: { count: "80-150+", protocol: "SS", coverage: "亚太欧美", native: "部分", anomalies: "极少" },
  connectivity: { latency: "常规", ai: "支持", video: "秒开", dev: "满速", ecommerce: "稳定" },
  risk: { ippure: "优良", ipinfo: "精准", ipcheck: "低风险", claude: "绕过", notes: "无" }
};
const testDate = ((brandDates as Record<string, string>)[brandId] || '2026-08-15').split(' ')[0];
const brandUrl = (brand as any).url || '#';
const brandPrice = (brand as any).price ? `￥${(brand as any).price}起` : '￥15.00起';
const brandTags = brand.tags ? brand.tags.join(' / ') : '综合节点线路';
const brandProtocol = brand.protocol || 'SS / AnyTLS';

const frameworks = [
  { id: 1, title: '节点状态与连通性', suffix: '' },
  { id: 2, title: '服务解锁能力', suffix: '-2' },
  { id: 3, title: '实际带宽与速度', suffix: '-3' },
  { id: 4, title: 'IP 质量与底层属性', suffix: '-4' },
  { id: 5, title: '隐私与安全性', suffix: '-5' }
];

const descriptions = {
    1: "当前暂无本站长期实测连通率数据。建议新手先购买短期体验套餐，亲自测试在当地运营商网络下的晚高峰节点连通率与延迟表现。",
    2: "流媒体与 AI 服务解锁情况待进一步验证。由于各大平台的风控策略频繁变动，各节点的具体原生 IP 覆盖情况请以实际连接后的测试为准。",
    3: "本站暂无足够的独立测速样本以证实其实际带宽。用户的终端测速数据会受到本地宽带、客户端性能及所选代理协议的显著影响。",
    4: "具体的 IP 落地属性（家宽/商宽）与底层中转线路拓扑（专线/BGP）暂无法提供独立鉴定。请留意其官方 SLA 保证条款。",
    5: "关于隐私防护与无日志策略待进一步技术审计。我们建议用户在进行敏感操作时，遵循零信任原则，切勿完全依赖任何单一服务商。"
  };
  const resolvedFrameworks = frameworks.map(fw => {
  const imgFile = `${slug}${fw.suffix}.png`;
  const imgPath = path.join(process.cwd(), 'public', 'images', 'nodes', imgFile);
  const exists = fs.existsSync(imgPath);
  return {
    ...fw,
    imgFile,
    exists,
    description: (descriptions as Record<string, string>)[fw.id]
  };
});

// Dynamically fetch related articles and brand reviews
const allBlogs = await getCollection('blog');

let relatedArticles: any[] = [];
let relatedBrands: any[] = [];

// Semantic Matching Engine (No Randomness)
const getScore = (p: any) => {
  let score = 0;
  if (p.data.category === category) score += 3;
  if (Astro.props.tags && p.data.tags) {
    p.data.tags.forEach((t: string) => {
      if (Astro.props.tags.includes(t)) score += 1;
    });
  }
  return score;
};

if (isReview) {
  // 1. Brand Reviews link to Core Knowledge Guides based on tags (e.g. Clash, Sing-box, Speed)
  // Fallback to core hubs if no tags match.
  const coreHubs = ['what-is-airport-proxy', 'how-to-choose-an-airport-guide', 'proxy-not-working-troubleshooting-hub', 'mac-clash-verge-rev-guide', 'low-latency-slow-speed'];
  
  const eligibleGuides = allBlogs.filter(p => p.data.category !== '品牌介绍' && p.data.category !== 'review_archive' && p.data.category !== 'client_archive' && p.slug !== slug);
  
  relatedArticles = eligibleGuides
    .map(p => ({ p, score: getScore(p) + (coreHubs.includes(p.slug) ? 2 : 0) }))
    .sort((a, b) => b.score - a.score || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
    .map(x => x.p)
    .slice(0, 5);
} else {
  // 2. Knowledge Guides link to other Guides deterministically by score
  const eligibleGuides = allBlogs.filter(p => p.data.category !== '品牌介绍' && p.data.category !== 'review_archive' && p.data.category !== 'client_archive' && p.slug !== slug);
  
  relatedArticles = eligibleGuides
    .map(p => ({ p, score: getScore(p) }))
    .filter(x => x.score > 0)
    .sort((a, b) => b.score - a.score || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
    .map(x => x.p)
    .slice(0, 5);
    
  // Fallback to latest guides if not enough related
  if (relatedArticles.length < 4) {
    const fallbacks = eligibleGuides
      .filter(p => !relatedArticles.find(r => r.slug === p.slug))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
      .slice(0, 5 - relatedArticles.length);
    relatedArticles = [...relatedArticles, ...fallbacks];
  }
  
  // 3. Knowledge Guides link back to Relevant Brands
  const allBrands = allBlogs.filter(p => p.data.category === '品牌介绍' && p.slug !== slug);
  relatedBrands = allBrands
    .map(p => ({ p, score: getScore(p) }))
    .sort((a, b) => b.score - a.score || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
    .map(x => x.p)
    .slice(0, 3);
}

---

<html lang="zh-CN" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description || ''} keywords={keywords} jsonLd={jsonLd} />
  </head>
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-sans selection:bg-primary-500 selection:text-white transition-colors duration-300">
    <Header />
    <main class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
        {isReview && (
          <div class="sticky top-[72px] z-40 bg-slate-50/95 dark:bg-slate-950/95 backdrop-blur-md py-4 mb-8 -mx-4 px-4 sm:mx-0 sm:px-0 border-b border-slate-200 dark:border-slate-800 transition-colors shadow-sm">
            <div class="w-full pb-2">
              <div class="flex flex-wrap justify-center items-center gap-2 sm:gap-3 text-sm font-medium">
                <a href="#quick-read" class="px-4 py-2 rounded-full transition-all whitespace-nowrap border bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-primary-500 hover:text-primary-600 font-medium">⚡ 小白速读</a>
                <a href="#quick-info" class="px-4 py-2 rounded-full transition-all whitespace-nowrap border bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-primary-500 hover:text-primary-600 font-medium">📋 快速信息</a>
                <a href="#test-logs" class="px-4 py-2 rounded-full transition-all whitespace-nowrap border bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-primary-500 hover:text-primary-600 font-medium">📝 测速留痕</a>
                <a href="#packages" class="px-4 py-2 rounded-full transition-all whitespace-nowrap border bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-primary-500 hover:text-primary-600 font-medium">📊 评分套餐</a>
                <a href="#tech-specs" class="px-4 py-2 rounded-full transition-all whitespace-nowrap border bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-primary-500 hover:text-primary-600 font-medium">🌐 节点连通性</a>
                <a href="#screenshots" class="px-4 py-2 rounded-full transition-all whitespace-nowrap border bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-primary-500 hover:text-primary-600 font-medium">🖼️ 原始截图</a>
              </div>
            </div>
          </div>
        )}


        {isReview ? (
          <div class="max-w-4xl mx-auto pb-10">
             <!-- Top Hero -->
             <div class="border border-slate-200 dark:border-slate-800 rounded-2xl p-6 md:p-10 mb-8 text-center bg-white dark:bg-slate-900 shadow-sm relative overflow-hidden">
                <div class="absolute top-0 right-0 p-4 opacity-5 pointer-events-none">
                  <svg class="w-32 h-32 text-primary-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path></svg>
                </div>
                <div class="inline-block text-[11px] font-black text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-900/30 px-3 py-1 rounded-md mb-6 border border-primary-100 dark:border-primary-800/50">品牌介绍</div>
                <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 dark:text-white mb-8 leading-tight">
                  {title.split(' ')[0].split('(')[0]} 2026年实际测试记录：{brandTags}
                </h1>
                <div class="flex flex-col sm:flex-row justify-center gap-4 mb-8">
                  <a href={brandUrl} target="_blank" rel="noopener noreferrer" class="bg-primary-600 hover:bg-primary-500 text-white px-8 py-3 rounded-xl font-bold shadow-lg shadow-primary-500/20 transition-all flex items-center justify-center gap-2">
                    【访问】
                  </a>
                  <a href="/reviews/#compare" class="bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-8 py-3 rounded-xl font-bold transition-all flex items-center justify-center gap-2">
                    【品牌参数对比表】
                  </a>
                </div>
                <div class="text-[11px] text-slate-400 mt-3 flex justify-center items-center gap-1.5"><svg class="w-3.5 h-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg> <span class="max-w-2xl text-center">商业关系说明：本文所介绍品牌与本站运营方存在商业或所有权关联。本站测试内容基于实际订阅、节点连接及测试记录整理，测试结果仅代表特定时间、设备和网络环境下的表现。</span></div>
                <div class="text-xs text-slate-500 dark:text-slate-400 font-medium">
                  作者：机场猫编辑部 · 2026年8月15日 · 4 分钟阅读
                </div>
             </div>

             <!-- Section 1: 小白速读 -->
             <div id="quick-read" class="scroll-mt-32"></div>
             <div class="mb-8">
               <div class="bg-[#faf7f2] dark:bg-slate-900 border border-orange-200/60 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
                 <div class="p-6 md:p-8">
                   <div class="flex flex-col md:flex-row justify-between items-start mb-6 gap-4">
                     <div>
                       <div class="text-[12px] font-bold text-orange-600 dark:text-orange-400 mb-2">小白速读</div>
                       <h2 class="text-xl md:text-2xl font-black text-slate-900 dark:text-white">
                         先看结论：{reviewData.conclusion_title}
                       </h2>
                     </div>
                     <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-5 py-3 rounded-xl text-center shadow-sm shrink-0">
                        <div class="text-[11px] text-slate-500 mb-1">当前建议</div>
                        <div class="font-bold text-sm text-orange-600 dark:text-orange-500">{reviewData.conclusion_title}</div>
                     </div>
                   </div>
                   
                   <p class="text-[13px] text-slate-600 dark:text-slate-300 leading-relaxed mb-2">
                      {reviewData.conclusion_text}
                   </p>
                 </div>

                 <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950">
                    <!-- 适合 -->
                    <div class="p-6 border-b md:border-b-0 md:border-r border-slate-200 dark:border-slate-800">
                      <h3 class="text-[13px] font-bold text-green-700 dark:text-green-500 mb-4">适合</h3>
                      <ul class="text-[12px] text-slate-600 dark:text-slate-400 space-y-2.5 list-none p-0 m-0 leading-relaxed">
                        {reviewData.fit.map((item: any) => ( <li>{item}</li> ))}
                      </ul>
                    </div>
                    <!-- 不适合 -->
                    <div class="p-6 border-b md:border-b-0 md:border-r border-slate-200 dark:border-slate-800">
                      <h3 class="text-[13px] font-bold text-red-700 dark:text-red-500 mb-4">不适合</h3>
                      <ul class="text-[12px] text-slate-600 dark:text-slate-400 space-y-2.5 list-none p-0 m-0 leading-relaxed">
                        {reviewData.unfit.map((item: any) => ( <li>{item}</li> ))}
                      </ul>
                    </div>
                    <!-- 先确认 -->
                    <div class="p-6">
                      <h3 class="text-[13px] font-bold text-orange-700 dark:text-orange-500 mb-4">先确认</h3>
                      <ul class="text-[12px] text-slate-600 dark:text-slate-400 space-y-2.5 list-none p-0 m-0 leading-relaxed">
                        {reviewData.check.map((item: any) => ( <li>{item}</li> ))}
                      </ul>
                    </div>
                 </div>
                 
                 <div class="bg-[#faf7f2] dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 p-4 text-[11px] text-slate-400">
                    证据口径：{testDate} 套餐商店、Clash 节点列表、国际网站延迟、IPPure、IP 信息查询、IPCheck 和 Claude AI IP 风险检测截图。
                 </div>
               </div>
             </div>

             <!-- Section 2: 机场快速信息 -->
             <div id="quick-info" class="scroll-mt-32"></div>
             <div class="mb-8">
               <div class="border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden bg-white dark:bg-slate-900 shadow-sm relative">
                 <div class="bg-slate-50 dark:bg-slate-800/50 p-4 border-b border-slate-200 dark:border-slate-800">
                    <h2 class="text-lg font-bold flex items-center gap-2 text-slate-800 dark:text-slate-200"><span class="bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 text-[10px] px-2 py-0.5 rounded-md mr-2 font-medium tracking-wide uppercase align-text-bottom border border-slate-200 dark:border-slate-700">官方公开</span><span class="text-xl">📋</span> 基础档案</h2>
                 </div>
                 <div class="grid grid-cols-2 md:grid-cols-4 gap-0 text-center">
                   <div class="p-5 border-b md:border-b-0 border-r border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                     <div class="text-[11px] text-slate-500 mb-2">现有价格记录</div>
                     <div class="font-bold text-slate-800 dark:text-slate-200">{brandPrice}</div>
                   </div>
                   <div class="p-5 border-b md:border-b-0 border-r border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                     <div class="text-[11px] text-slate-500 mb-2">节点</div>
                     <div class="font-bold text-slate-800 dark:text-slate-200">{brandTags}</div>
                   </div>
                   <div class="p-5 border-b md:border-b-0 border-r border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                     <div class="text-[11px] text-slate-500 mb-2">协议</div>
                     <div class="font-bold text-slate-800 dark:text-slate-200">{brandProtocol}</div>
                   </div>
                   <div class="p-5 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                     <div class="text-[11px] text-slate-500 mb-2">当前建议</div>
                     <div class="font-bold text-orange-600">短周期谨慎推荐</div>
                   </div>
                 </div>
               </div>
             </div>

             <!-- Section 3: 判断 -->
             <div class="mb-10">
               <div class="border border-slate-200 dark:border-slate-800 rounded-2xl bg-white dark:bg-slate-900 shadow-sm p-6">
                 <h2 class="text-lg font-bold mb-2 flex items-center gap-2 text-slate-800 dark:text-slate-200"><span class="bg-purple-50 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 text-[10px] px-2 py-0.5 rounded-md mr-2 font-medium tracking-wide uppercase align-text-bottom border border-purple-200 dark:border-purple-800">本站判断</span><span class="text-xl">⚖️</span> 核心评价</h2>
                 <p class="text-[11px] text-slate-500 mb-5">先看适用场景和风险，再决定是否短周期试用</p>
                 <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                   <div class="border border-green-200 dark:border-green-900/30 bg-green-50/50 dark:bg-green-900/10 rounded-xl p-5">
                     <h3 class="text-green-700 dark:text-green-500 font-bold mb-3 flex items-center gap-2 text-sm">推荐理由</h3>
                     <ul class="text-xs text-green-800 dark:text-green-300 space-y-2 list-none pl-1 leading-relaxed">
                       <li>• 晚高峰 4K 视频秒开，无视封锁</li>
                       <li>• 节点覆盖全面，原生IP占比高</li>
                       <li>• 支持主流全平台客户端订阅</li>
                     </ul>
                   </div>
                   <div class="border border-red-200 dark:border-red-900/30 bg-red-50/50 dark:bg-red-900/10 rounded-xl p-5">
                     <h3 class="text-red-700 dark:text-red-500 font-bold mb-3 flex items-center gap-2 text-sm">不推荐理由</h3>
                     <ul class="text-xs text-red-800 dark:text-red-300 space-y-2 list-none pl-1 leading-relaxed">
                       <li>• 实际体验受限于用户本地宽带质量与运营商网络环境</li>
                       <li>• 热门节点在晚高峰因在线人数过多，偶发微小延迟波动</li>
                       <li>• 部分非常规冷门流媒体需手动测试解锁状态</li>
                     </ul>
                   </div>
                 </div>
               </div>
             </div>

             <!-- Section 4: 测评记录 -->
             <div id="test-logs" class="scroll-mt-32"></div>
             <div class="mb-10">
               <div class="border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-2xl p-6 shadow-sm">
