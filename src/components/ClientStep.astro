---
const { num, img, size = "sm" } = Astro.props;

let maxWidthClass = "max-w-[300px]";
if (size === "md") maxWidthClass = "max-w-md";
if (size === "lg") maxWidthClass = "max-w-2xl";
if (size === "xl") maxWidthClass = "max-w-4xl";
if (size === "full") maxWidthClass = "max-w-full";
---
<div class="bg-slate-50 dark:bg-slate-800/40 rounded-xl p-5 border border-slate-100 dark:border-slate-700/50 transition-colors hover:border-indigo-500/30 mb-6">
  <div class="flex flex-col sm:flex-row gap-4">
    <div class="shrink-0 w-8 h-8 bg-indigo-100 dark:bg-indigo-900/50 text-indigo-600 dark:text-indigo-400 rounded-full flex items-center justify-center font-bold">{num}</div>
    <div class="w-full">
      <div class="text-slate-700 dark:text-slate-300 mb-4 mt-1 leading-relaxed prose-sm dark:prose-invert">
        <slot />
      </div>
      {img && (
        <div class={`rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700 shadow-sm mx-auto sm:mx-0 ${maxWidthClass}`}>
          <img src={img} alt={`Step ${num} Screenshot`} class="w-full block" />
        </div>
      )}
    </div>
  </div>
</div>
