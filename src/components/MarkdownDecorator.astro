---
// DOM Decorator to transform Markdown into a Knowledge Base Design System
---

<script>
document.addEventListener('DOMContentLoaded', () => {
  const article = document.querySelector('.article-content-wrapper');
  if (!article) return;

  // 1. Process Callouts from blockquotes
  const blockquotes = article.querySelectorAll('blockquote');
  blockquotes.forEach(bq => {
    let html = bq.innerHTML;
    let text = bq.textContent || '';
    
    let type = 'info';
    let icon = '<svg class="w-5 h-5 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
    let colorClass = 'bg-blue-50 dark:bg-blue-900/20 border-blue-500 text-blue-800 dark:text-blue-200';
    let title = '提示信息';

    const match = text.match(/^\s*(\[!NOTE\]|\[!TIP\]|\[!WARNING\]|\[!CAUTION\]|\[!IMPORTANT\]|注意：|警告：|提示：|提示:)/i);
    
    if (match) {
      const token = match[1].toUpperCase();
      html = html.replace(match[1], '').trim();
      
      if (token.includes('WARN') || token.includes('注意')) {
        type = 'warning';
        icon = '<svg class="w-5 h-5 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>';
        colorClass = 'bg-amber-50 dark:bg-amber-900/20 border-amber-500 text-amber-900 dark:text-amber-200';
        title = '注意事项';
      } else if (token.includes('CAUTION') || token.includes('警告') || token.includes('IMPORTANT')) {
        type = 'danger';
        icon = '<svg class="w-5 h-5 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
        colorClass = 'bg-red-50 dark:bg-red-900/20 border-red-500 text-red-900 dark:text-red-200';
        title = '重要警告';
      } else if (token.includes('TIP') || token.includes('提示')) {
        type = 'success';
        icon = '<svg class="w-5 h-5 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
        colorClass = 'bg-emerald-50 dark:bg-emerald-900/20 border-emerald-500 text-emerald-900 dark:text-emerald-200';
        title = '小技巧';
      }
      
      const newBq = document.createElement('div');
      newBq.className = `my-8 p-5 rounded-2xl border-l-4 flex gap-4 ${colorClass} shadow-sm`;
      newBq.innerHTML = `
        <div class="text-[inherit] opacity-80">${icon}</div>
        <div class="flex-1 text-[14px] leading-relaxed">
          <div class="font-bold mb-2 opacity-90">${title}</div>
          <div class="prose-p:my-1 prose-a:font-bold prose-code:bg-black/5 dark:prose-code:bg-white/10 prose-code:text-[inherit]">${html}</div>
        </div>
      `;
      if(bq.parentNode) bq.parentNode.replaceChild(newBq, bq);
    }
  });

  // 2. Process Tables (Like the modern framework screenshot)
  const tables = article.querySelectorAll('table');
  tables.forEach(table => {
    if (!table.parentElement?.classList.contains('table-wrapper')) {
      const wrapper = document.createElement('div');
      // Enhance table wrapper with beautiful styling
      wrapper.className = 'table-wrapper overflow-x-auto my-10 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm bg-white dark:bg-slate-900/80 backdrop-blur';
      if(table.parentNode) {
        table.parentNode.insertBefore(wrapper, table);
        wrapper.appendChild(table);
      }
      
      table.className = 'w-full text-sm text-left m-0 border-0 border-collapse';
      
      const ths = table.querySelectorAll('th');
      ths.forEach(th => {
        th.className = 'bg-slate-50 dark:bg-slate-800/80 px-4 py-4 font-bold text-slate-700 dark:text-slate-300 border-b border-slate-200 dark:border-slate-700 whitespace-nowrap';
      });
      
      const tds = table.querySelectorAll('td');
      tds.forEach(td => {
        td.className = 'px-4 py-4 border-b border-slate-100 dark:border-slate-800/50 text-slate-600 dark:text-slate-400';
      });
    }
  });

  // 3. Process Steps (for H2 or H3 starting with "步骤" or "Step")
  const headings = Array.from(article.querySelectorAll('h2, h3'));
  let i = 0;
  while (i < headings.length) {
    const h = headings[i];
    const text = h.textContent?.trim() || '';
    if (/^(步骤|Step)[\s:-]*\d*/i.test(text)) {
      const stepGroups = [];
      
      // Collect all consecutive steps
      while (i < headings.length && /^(步骤|Step)[\s:-]*\d*/i.test(headings[i].textContent?.trim() || '')) {
        const currH = headings[i];
        const currText = currH.textContent?.trim() || '';
        const cleanText = currText.replace(/^(步骤|Step)[\s:-]*\d*\s*[:：]?\s*/i, '');
        const nodes = [];
        let next = currH.nextElementSibling;
        while (next && !['H1', 'H2', 'H3'].includes(next.tagName)) {
          nodes.push(next);
          next = next.nextElementSibling;
        }
        stepGroups.push({ heading: currH, cleanText: cleanText || currText, nodes });
        i++;
      }

      if (stepGroups.length > 0) {
        const stepsContainer = document.createElement('div');
        stepsContainer.className = 'steps-container relative mt-10 mb-12';
        
        const vLine = document.createElement('div');
        vLine.className = 'absolute left-[19px] top-8 bottom-8 w-1 bg-indigo-50 dark:bg-indigo-900/30 z-0 hidden sm:block rounded-full';
        stepsContainer.appendChild(vLine);

        stepGroups.forEach((group, idx) => {
          const num = idx + 1;
          const stepCard = document.createElement('div');
          stepCard.className = 'step-card relative pl-12 md:pl-16 py-4 mb-6 z-10';
          
          const badge = document.createElement('div');
          badge.className = 'absolute left-0 top-4 w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-indigo-600 text-white font-black flex items-center justify-center border-4 border-white dark:border-slate-900 shadow-md z-10 text-base font-mono tracking-tighter';
          badge.textContent = num < 10 ? `0${num}` : num.toString();
          stepCard.appendChild(badge);
          
          const contentWrapper = document.createElement('div');
          contentWrapper.className = 'bg-white dark:bg-slate-900/50 rounded-3xl p-6 md:p-8 border border-slate-200 dark:border-slate-800 shadow-sm hover:border-indigo-200 dark:hover:border-indigo-800 hover:shadow-md transition-all duration-300';
          
          const newH = document.createElement(group.heading.tagName);
          newH.className = 'text-xl md:text-2xl font-black text-slate-900 dark:text-white mb-4 mt-0 border-0 pb-0 flex items-center';
          newH.textContent = group.cleanText;
          contentWrapper.appendChild(newH);

          group.nodes.forEach(n => contentWrapper.appendChild(n));
          stepCard.appendChild(contentWrapper);
          
          stepsContainer.appendChild(stepCard);
        });

        // Insert container before the first heading
        const firstGroup = stepGroups[0];
        if (firstGroup.heading.parentNode) {
          firstGroup.heading.parentNode.insertBefore(stepsContainer, firstGroup.heading);
        }
        // Remove original headings
        stepGroups.forEach(g => {
          if (g.heading.parentNode) g.heading.parentNode.removeChild(g.heading);
        });
      }
    } else {
      i++;
    }
  }
  
  // 4. Enhance all regular H2 tags with the "Framework" bottom border and layout
  const allH2 = article.querySelectorAll('h2:not(.step-card h2)');
  allH2.forEach(h2 => {
    // Wrap the text in a flex container with a subtle bottom line and left accent
    h2.className = 'group relative flex items-center text-2xl font-black text-slate-900 dark:text-white pb-4 mb-8 mt-16 !border-b !border-slate-200 dark:!border-slate-800';
    
    const emojiMatch = h2.innerHTML.match(/^([\uD800-\uDBFF][\uDC00-\uDFFF]|\p{Emoji_Presentation}|\p{Emoji}\uFE0F)\s*(.*)/u);
    
    if (emojiMatch) {
       // It already has an emoji, enhance it
       h2.innerHTML = `<span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-900/30 mr-3 text-xl">${emojiMatch[1]}</span>${emojiMatch[2]}`;
    } else {
       // Add a beautiful gradient left bar if no emoji exists
       h2.innerHTML = `<span class="w-1.5 h-7 rounded-full bg-gradient-to-b from-indigo-500 to-indigo-600 mr-4 shadow-sm inline-block"></span>${h2.innerHTML}`;
    }
  });

  
  // 6. Enhance Images
  const images = article.querySelectorAll('img');
  images.forEach(img => {
    img.className = 'rounded-2xl border border-slate-200 dark:border-slate-800 shadow-md my-8 mx-auto';
  });

  // 5. Enhance regular H3 tags
  const allH3 = article.querySelectorAll('h3:not(.step-card h3)');
  allH3.forEach(h3 => {
    h3.className = 'text-xl font-bold text-slate-800 dark:text-slate-100 mb-6 mt-10 flex items-center gap-2 before:content-[""] before:block before:w-2 before:h-2 before:rounded-full before:bg-indigo-400 !mt-10';
  });

});
</script>

