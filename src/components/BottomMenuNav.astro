---
const currentPath = Astro.url.pathname;
const links = [
  { path: "/reviews/", label: "机场推荐" },
  { path: "/evaluations/", label: "机场测评" },
  { path: "/clients/", label: "客户端" },
  { path: "/guides/", label: "知识指南" },
  { path: "/tools/", label: "网络工具" },
];
---
<div class="max-w-7xl mx-auto px-4 pb-12 pt-8 w-full border-t border-slate-200 dark:border-slate-800 mt-16">
  <div class="text-center mb-6">
    <h3 class="text-sm font-bold text-slate-500 uppercase tracking-wider">快速游览其他菜单</h3>
  </div>
  <div class="flex flex-wrap justify-center gap-3 sm:gap-4">
    {links.map((link) => (
      !currentPath.includes(link.path) ? (
        <a 
          href={link.path} 
          class="px-5 py-2 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 rounded-lg text-sm font-bold hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-blue-600 dark:hover:text-blue-400 border border-slate-200 dark:border-slate-700 transition-all shadow-sm hover:shadow"
        >
          [{link.label}]
        </a>
      ) : null
    ))}
  </div>
</div>
