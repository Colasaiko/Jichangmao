---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { text: '首页', href: '/' },
  { text: '机场推荐', href: '/reviews/' },
  { text: '机场评测', href: '/evaluations/' },
  { text: '客户端', href: '/clients/' },
  { text: '知识指南', href: '/guides/' },
  { text: '网络工具', href: '/tools/' },
  { text: '关于本站', href: '/about/' }
];
---

<header id="site-header" class="fixed top-0 z-50 w-full transition-all duration-300 ease-out bg-white/0 border-b border-transparent">
  <div class="max-w-7xl mx-auto">
    <div id="header-container" class="transition-all duration-300 ease-out py-5 lg:px-4 px-4 sm:px-6 md:px-8">
      <div class="relative flex items-center justify-between">
        <a href="/" class="flex-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded-md flex items-center gap-3">
          <img src="/logo.jpg" alt="机场猫 Logo" class="h-10 w-auto object-contain rounded-full shadow-sm" />
          <span class="font-bold text-xl tracking-tight text-slate-900 dark:text-white">机场猫</span>
        </a>
        
        <div class="relative hidden md:flex items-center ml-auto">
          <nav class="text-xs leading-6 font-semibold text-slate-700 dark:text-slate-200">
            <ul class="flex space-x-3 lg:space-x-5 text-sm">
              {links.map((link) => (
                <li>
                  <a href={link.href} class="relative group px-1 py-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded-md">
                    <span class="transition-colors duration-200 hover:text-primary-600 dark:hover:text-primary-400">
                      {link.text}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="flex items-center border-l border-slate-200 dark:border-slate-800 ml-6 pl-6">
            <ThemeToggle />
          </div>
        </div>

        <div class="flex md:hidden items-center">
          <ThemeToggle />
          <button id="mobile-menu-btn" class="ml-4 text-slate-500 dark:text-slate-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded-md p-1 transition-colors hover:text-primary-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
          </button>
        </div>
      </div>
    </div>
    
    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 dark:border-slate-800 pb-4 px-4 sm:px-6 bg-white dark:bg-slate-950">
      <nav class="flex flex-col space-y-4 pt-4 text-sm font-semibold text-slate-700 dark:text-slate-200">
        {links.map((link) => (
          <a href={link.href} class="block transition-colors p-3 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-slate-50 dark:hover:bg-slate-900/50">
            {link.text}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Header scroll interaction
  const header = document.getElementById('site-header');
  const headerContainer = document.getElementById('header-container');
  
  const handleScroll = () => {
    if (window.scrollY > 20) {
      header?.classList.add('bg-white/80', 'dark:bg-slate-950/80', 'backdrop-blur-md', 'border-slate-200', 'dark:border-slate-800', 'shadow-sm');
      header?.classList.remove('bg-white/0', 'border-transparent');
      headerContainer?.classList.remove('py-5');
      headerContainer?.classList.add('py-3');
    } else {
      header?.classList.remove('bg-white/80', 'dark:bg-slate-950/80', 'backdrop-blur-md', 'border-slate-200', 'dark:border-slate-800', 'shadow-sm');
      header?.classList.add('bg-white/0', 'border-transparent');
      headerContainer?.classList.remove('py-3');
      headerContainer?.classList.add('py-5');
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll(); // init on load
</script>
